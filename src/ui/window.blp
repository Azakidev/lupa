using Gtk 4.0;
using Adw 1;

template $LupaWindow: Adw.ApplicationWindow {
    width-request: 600;
    height-request: 48;

    styles [
        "launcher",
    ]

    content: Adw.OverlaySplitView sidebar_view {
        sidebar-position: end;
        collapsed: false;
        show-sidebar: false;
        sidebar-width-fraction: 0.5;

        sidebar: Adw.NavigationPage {
            title: _("Detail page");

            styles [
                "launcher_sidebar",
            ]

            ScrolledWindow {
                hscrollbar-policy: never;

                child: Adw.Bin sidebar_content {
                    margin-top: 12;
                    margin-bottom: 12;
                    margin-start: 12;
                    margin-end: 12;
                };
            }
        };

        Box {
            margin-top: 8;
            orientation: vertical;

            Box {
                orientation: horizontal;
                spacing: 4;
                margin-start: 16;
                margin-bottom: 8;

                Image {
                    icon-name: "search";
                    pixel-size: 24;

                    styles [
                        "dimmed",
                    ]

                    accessibility {
                        label: _("Search");
                    }
                }

                Entry input {
                    margin-start: 8;
                    margin-end: 8;
                    hexpand: true;
                    vexpand: true;
                    valign: center;

                    styles [
                        "flat",
                        "searcher",
                    ]

                    text: _("");
                    placeholder-text: _("Search anything…");
                }
            }

            Revealer result_revealer {
                reveal-child: false;

                Box {
                    orientation: vertical;

                    Separator {
                        orientation: horizontal;
                        hexpand: true;
                    }

                    ScrolledWindow scroller {
                        hscrollbar-policy: never;

                        Box results {
                            orientation: vertical;
                            margin-top: 4;
                            margin-bottom: 8;
                            spacing: 2;
                        }
                    }
                }
            }
        }
    };
}
